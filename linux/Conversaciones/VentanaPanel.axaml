<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Conversaciones.VentanaPanel"
        Title="Conversaciones"
        Width="380" MinHeight="180" Height="520"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!-- Mismo truco que en Windows: la ventana transparente y el fondo OPACO en un
       Border de adentro, con el margen que necesita la sombra para no recortarse. -->
  <Border Background="#161A20" CornerRadius="14" Margin="12" Padding="14,12"
          BoxShadow="0 6 18 0 #66000000">
    <DockPanel>

      <Grid DockPanel.Dock="Top" Name="barraTitulo" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Text="Conversaciones" Foreground="#F2F5F9" FontSize="13.5"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="btnRefrescar" Content="&#x21BB;" Padding="7,1"
                Background="Transparent" Foreground="#6B7385" BorderThickness="0"
                ToolTip.Tip="Actualizar ahora" />
        <Button Grid.Column="2" Name="btnCerrar" Content="&#x2715;" Padding="7,1"
                Background="Transparent" Foreground="#6B7385" BorderThickness="0"
                ToolTip.Tip="Cerrar el panel" />
      </Grid>

      <TextBlock DockPanel.Dock="Bottom" Name="pie" Foreground="#4D5462" FontSize="10.5"
                 Margin="2,8,2,0" TextWrapping="Wrap" />

      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Name="lista" Spacing="8" />
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
